{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SearchOutput",
  "description": "`note.search` (`patinote search`).",
  "type": "object",
  "properties": {
    "query": {
      "type": "string"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SearchResult"
      }
    },
    "total": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "truncated": {
      "type": "boolean"
    },
    "v": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OutputWarning"
      }
    }
  },
  "required": [
    "v",
    "query",
    "total",
    "truncated",
    "results",
    "warnings"
  ],
  "$defs": {
    "OutputWarning": {
      "description": "A problem that did not stop the command. Shown on stderr in text mode,\nin `\"warnings\"` with `--json`; with `--strict` it makes the exit code 1.",
      "type": "object",
      "properties": {
        "code": {
          "description": "`not_utf8`, `too_large`, `unreadable`, `frontmatter_invalid`,\n`symlink_loop`, `invalid_name`, `invalid_ignore_file`, `config`, `index_rebuilt`.",
          "type": "string"
        },
        "line": {
          "description": "1-based line, when the warning has one.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "message": {
          "type": "string"
        },
        "path": {
          "description": "Vault-relative path, when the warning is about one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "SearchResult": {
      "description": "One `note.search` result.",
      "type": "object",
      "properties": {
        "line": {
          "description": "First line with a match.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "path": {
          "type": "string"
        },
        "snippet": {
          "description": "Text around the match, matches in `[` `]`.",
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "title",
        "line",
        "snippet"
      ]
    }
  }
}
