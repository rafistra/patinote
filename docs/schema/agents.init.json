{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentsInitOutput",
  "description": "`agents.init` (`patinote agents init`).",
  "type": "object",
  "properties": {
    "unchanged": {
      "description": "Files that already had the right content.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "v": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OutputWarning"
      }
    },
    "written": {
      "description": "Files created or updated.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "v",
    "written",
    "unchanged",
    "warnings"
  ],
  "$defs": {
    "OutputWarning": {
      "description": "A problem that did not stop the command. Shown on stderr in text mode,\nin `\"warnings\"` with `--json`; with `--strict` it makes the exit code 1.",
      "type": "object",
      "properties": {
        "code": {
          "description": "`not_utf8`, `too_large`, `unreadable`, `frontmatter_invalid`,\n`symlink_loop`, `invalid_name`, `invalid_ignore_file`, `config`, `index_rebuilt`.",
          "type": "string"
        },
        "line": {
          "description": "1-based line, when the warning has one.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "message": {
          "type": "string"
        },
        "path": {
          "description": "Vault-relative path, when the warning is about one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "message"
      ]
    }
  }
}
