{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UnresolvedOutput",
  "description": "`link.unresolved` (`patinote unresolved`).",
  "type": "object",
  "properties": {
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/UnresolvedTarget"
      }
    },
    "total": {
      "description": "Distinct missing notes.",
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "v": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OutputWarning"
      }
    }
  },
  "required": [
    "v",
    "total",
    "targets",
    "warnings"
  ],
  "$defs": {
    "OutputWarning": {
      "description": "A problem that did not stop the command. Shown on stderr in text mode,\nin `\"warnings\"` with `--json`; with `--strict` it makes the exit code 1.",
      "type": "object",
      "properties": {
        "code": {
          "description": "`not_utf8`, `too_large`, `unreadable`, `frontmatter_invalid`,\n`symlink_loop`, `invalid_name`, `invalid_ignore_file`, `config`, `index_rebuilt`.",
          "type": "string"
        },
        "line": {
          "description": "1-based line, when the warning has one.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "message": {
          "type": "string"
        },
        "path": {
          "description": "Vault-relative path, when the warning is about one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "SourceLine": {
      "description": "Where a link is written.",
      "type": "object",
      "properties": {
        "line": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "line"
      ]
    },
    "UnresolvedTarget": {
      "description": "One missing note in `link.unresolved`.",
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceLine"
          }
        },
        "target": {
          "description": "The name as first written.",
          "type": "string"
        }
      },
      "required": [
        "target",
        "count",
        "sources"
      ]
    }
  }
}
