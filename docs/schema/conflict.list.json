{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConflictsOutput",
  "description": "`conflict.list` (`patinote conflicts`).",
  "type": "object",
  "properties": {
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ConflictOut"
      }
    },
    "total": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "v": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OutputWarning"
      }
    }
  },
  "required": [
    "v",
    "total",
    "conflicts",
    "warnings"
  ],
  "$defs": {
    "ConflictOut": {
      "description": "One Syncthing conflict copy.",
      "type": "object",
      "properties": {
        "modified": {
          "type": "string"
        },
        "original": {
          "description": "The note it conflicts with.",
          "type": "string"
        },
        "path": {
          "description": "The copy.",
          "type": "string"
        },
        "size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "original",
        "modified",
        "size"
      ]
    },
    "OutputWarning": {
      "description": "A problem that did not stop the command. Shown on stderr in text mode,\nin `\"warnings\"` with `--json`; with `--strict` it makes the exit code 1.",
      "type": "object",
      "properties": {
        "code": {
          "description": "`not_utf8`, `too_large`, `unreadable`, `frontmatter_invalid`,\n`symlink_loop`, `invalid_name`, `invalid_ignore_file`, `config`, `index_rebuilt`.",
          "type": "string"
        },
        "line": {
          "description": "1-based line, when the warning has one.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "message": {
          "type": "string"
        },
        "path": {
          "description": "Vault-relative path, when the warning is about one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "message"
      ]
    }
  }
}
