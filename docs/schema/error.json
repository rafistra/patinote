{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ErrorOutput",
  "description": "An error, written to stderr with `--json`; stdout stays empty (A-02).",
  "type": "object",
  "properties": {
    "error": {
      "$ref": "#/$defs/ErrorBody"
    },
    "v": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "v",
    "error"
  ],
  "$defs": {
    "ErrorBody": {
      "description": "The `\"error\"` object.",
      "type": "object",
      "properties": {
        "candidates": {
          "description": "The matching notes, for `ambiguous_note`.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "ErrorCode": {
      "description": "Error codes (A-02) and the exit code each one maps to (A-03).",
      "type": "string",
      "enum": [
        "vault_not_found",
        "note_not_found",
        "ambiguous_note",
        "invalid_argument",
        "index_locked",
        "io_error",
        "not_utf8"
      ]
    }
  }
}
